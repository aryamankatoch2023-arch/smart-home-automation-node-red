    {
        "id": "a37c37853a722a08",
        "type": "function",
        "z": "166d85307217b784",
        "name": "Smart Home Controller",
        "func": "\nlet light = context.get(\"light\") || false;\nlet fan = context.get(\"fan\") || false;\nlet autoLight = context.get(\"autoLight\");\nlet autoFan = context.get(\"autoFan\");\nlet temperature = context.get(\"temperature\");\nlet motion = context.get(\"motion\") || false;\nlet idleTicks = context.get(\"idleTicks\") || 0;\n\n// Dashboard controls send commands using msg.topic\nif (msg.topic === \"light\") {\n    light = Boolean(msg.payload);\n}\nif (msg.topic === \"fan\") {\n    fan = Boolean(msg.payload);\n}\nif (msg.topic === \"autoLight\") {\n    autoLight = Boolean(msg.payload);\n}\nif (msg.topic === \"autoFan\") {\n    autoFan = Boolean(msg.payload);\n}\n\n// Initialize default automatic modes\nif (autoLight === undefined) autoLight = true;\nif (autoFan === undefined) autoFan = true;\n\n// Update simulated sensors on each timer tick\nif (msg.topic === \"tick\" || msg.topic === \"inject\") {\n    temperature = temperature === undefined\n        ? 24\n        : Math.max(20, Math.min(36,\n            temperature + (Math.random() - 0.48) * 2));\n\n    motion = Math.random() < 0.35;\n\n    if (motion) {\n        idleTicks = 0;\n    } else {\n        idleTicks++;\n    }\n\n    if (autoLight && motion) {\n        light = true;\n    } else if (autoLight && idleTicks >= 3) {\n        light = false;\n    }\n\n    if (autoFan && temperature >= 28) {\n        fan = true;\n    } else if (autoFan && temperature <= 25) {\n        fan = false;\n    }\n}\n\ncontext.set(\"light\", light);\ncontext.set(\"fan\", fan);\ncontext.set(\"autoLight\", autoLight);\ncontext.set(\"autoFan\", autoFan);\ncontext.set(\"temperature\", temperature);\ncontext.set(\"motion\", motion);\ncontext.set(\"idleTicks\", idleTicks);\n\nlet energy = 0;\n\nif (light) {\n    energy += 5 + Math.random() * 15;\n}\n\nif (fan) {\n    energy += 20 + Math.random() * 40;\n}\n\nenergy = Math.round(energy * 10) / 10;\nlet alert = motion\n    ? \"Motion detected\"\n    : \"No motion detected\";\n\nreturn [\n    { payload: light ? \"ON\" : \"OFF\" },\n    { payload: fan ? \"ON\" : \"OFF\" },\n    { payload: temperature === undefined ? 24 : +temperature.toFixed(1) },\n    { payload: motion ? \"DETECTED\" : \"CLEAR\" },\n    { payload: alert },\n    { payload: energy }\n];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
